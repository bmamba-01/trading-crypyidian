# Môi trường local mặc định chỉ chạy paper, không kết nối tài khoản thật.
TRADING_BOT_APP_ENV=local
TRADING_BOT_TRADING_MODE=PAPER
# Chính sách TEST scorer được ghim trước khi mở TEST; đổi bất kỳ giá trị nào sẽ đổi hash policy.
TRADING_BOT_SCORER_TEST_POLICY_VERSION=wp06-scorer-test-v1
# Tổng số mẫu TEST tối thiểu; tránh kết luận từ holdout quá nhỏ.
TRADING_BOT_SCORER_TEST_POLICY_MINIMUM_SAMPLE_COUNT=1000
# Số mẫu tối thiểu cho từng lớp âm/trung tính/dương.
TRADING_BOT_SCORER_TEST_POLICY_MINIMUM_CLASS_SUPPORT=100
# ECE tối đa; đọc cùng log-loss/Brier vì ECE phụ thuộc cách chia bin.
TRADING_BOT_SCORER_TEST_POLICY_MAXIMUM_CALIBRATION_ERROR=0.05
# Mức log-loss được phép kém hơn baseline tốt hơn (prior hoặc identity).
TRADING_BOT_SCORER_TEST_POLICY_MAXIMUM_LOG_LOSS_REGRESSION=0.01
# Mức Brier được phép kém hơn baseline prior.
TRADING_BOT_SCORER_TEST_POLICY_MAXIMUM_BRIER_REGRESSION=0.01
# Tỷ lệ mẫu TEST tối thiểu scorer phải chấm, thay vì abstain.
TRADING_BOT_SCORER_TEST_POLICY_MINIMUM_COVERAGE=0.80
# Tỷ lệ candidate tối thiểu cần được approve để tránh lọc gần hết tín hiệu.
TRADING_BOT_SCORER_TEST_POLICY_MINIMUM_CANDIDATE_RETENTION=0.20
# Tỷ lệ cơ hội dương tối đa bị veto nhầm.
TRADING_BOT_SCORER_TEST_POLICY_MAXIMUM_FALSE_VETO_RATE=0.10
# Xác suất lớp dương tối thiểu để approve candidate.
TRADING_BOT_SCORER_TEST_POLICY_APPROVE_PROBABILITY_THRESHOLD=0.60
# Confidence tối thiểu; dưới mức này scorer phải abstain.
TRADING_BOT_SCORER_TEST_POLICY_MINIMUM_CONFIDENCE=0.55
# Số bin reliability cố định trong báo cáo ECE.
TRADING_BOT_SCORER_TEST_POLICY_RELIABILITY_BIN_COUNT=10
# Độ lệch chuẩn hóa tuyệt đối lớn nhất của một đặc trưng trước khi runtime coi đầu vào là OOD.
# Đây là hàng rào kỹ thuật ban đầu, chưa phải ngưỡng phổ quát hay bằng chứng hiệu quả giao dịch.
TRADING_BOT_SCORER_TEST_POLICY_MAXIMUM_STANDARDIZED_FEATURE_DEVIATION=6.0
# Deadline phép tính scorer; quá hạn runtime ghi ABSTAIN, không gồm truy vấn/commit DB.
TRADING_BOT_SCORER_TEST_POLICY_RUNTIME_INFERENCE_TIMEOUT_MS=100
